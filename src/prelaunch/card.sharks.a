!cpu 6502
!to "build/PRELAUNCH.INDEXED/CARD.SHARKS",plain
*=$106

         !source "src/macros.a"

         +ENABLE_ACCEL
         lda   #$60
         sta   $A18
         jsr   $800     ; load "DOS"
         lda   #<callback1
         sta   $B748
         lda   #>callback1
         sta   $B749
         jmp   $B700

callback1
         lda   #$60
         sta   $A37
         jsr   $A1B
         +DISABLE_ACCEL
         jmp   $C00

!if * > PrelaunchMax {
  !error "code is too large, ends at ", *
}
